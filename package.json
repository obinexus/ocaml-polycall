{
  "name": "ocaml-polycall",
  "version": "1.0.0",
  "description": "OCaml binding for the Polycall C library, binding ABI v1 (polycall >= 1.1.0). Source distribution of a dune project; not a JavaScript library.",
  "main": "index.js",
  "type": "commonjs",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./include/*": "./include/*",
    "./dist/*": "./dist/*",
    "./examples/*": "./examples/*",
    "./test/*": "./test/*",
    "./tests/*": "./tests/*",
    "./scripts/*": "./scripts/*",
    "./config": "./ocaml-polycallrc",
    "./manifest": "./polycall-binding.json"
  },
  "files": [
    "index.js",
    "dune-project",
    "ocaml-polycall.opam",
    "src/",
    "include/",
    "dist/",
    "examples/",
    "test/",
    "tests/",
    "scripts/",
    "Makefile",
    "ocaml-polycallrc",
    "polycall-binding.json",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "directories": {
    "lib": "src",
    "src": "src",
    "include": "include",
    "dist": "dist",
    "example": "examples",
    "test": "test",
    "scripts": "scripts"
  },
  "scripts": {
    "build": "dune build",
    "test": "sh scripts/test-linux.sh",
    "test:adapter": "make test-adapter",
    "test:valgrind": "make test-valgrind",
    "test:asan": "make test-asan",
    "test:package": "node tests/package.test.js",
    "verify:dry": "sh scripts/verify-dry.sh",
    "verify:dry:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-dry.ps1",
    "prepack": "node tests/package.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/ocaml-polycall.git"
  },
  "keywords": [
    "libpolycall",
    "polycall",
    "ocaml",
    "dune",
    "ffi",
    "native"
  ],
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/obinexus/ocaml-polycall/issues"
  },
  "homepage": "https://github.com/obinexus/ocaml-polycall#readme"
}
